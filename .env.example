# --- Database ---
# Local dev default (SQLite, zero setup). Swap to Postgres for real use — see README.
DATABASE_URL="file:./dev.db"
# Postgres example:
# DATABASE_URL="postgresql://user:password@localhost:5432/campaign_panel"

# --- Auth ---
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in, restricted to the theboredmonkey.com Workspace domain
# (see src/lib/auth.ts). Create these in Google Cloud Console:
# APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# (type: Web application). Add this Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://yourdomain.com/api/auth/callback/google  (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Integrations (Phase 2, add when ready — see README) ---
YOUTUBE_API_KEY=""
# Long-lived token for a Meta app + connected Instagram Business/Creator account.
# See SETUP_INSTAGRAM.md for how to get both of these.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
INSTAGRAM_PROVIDER_API_KEY=""
# Shared secret your browser extension sends as the x-api-key header when
# POSTing captured profile data to /api/extension/instagram-profile.
# Generate any random string, e.g.: openssl rand -hex 24
EXTENSION_API_KEY=""

# --- Daily Google Sheet sync (see SETUP_GOOGLE_SHEETS_SYNC.md) ---
GOOGLE_SHEETS_ID=""
GOOGLE_SHEETS_RANGE="Sheet1"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Secret for the /api/cron/sync-instagram-sheet endpoint. Generate any
# random string, e.g.: openssl rand -hex 24
CRON_SECRET=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="notifications@yourdomain.com"
